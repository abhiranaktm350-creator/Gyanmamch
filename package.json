{
  "name": "gyan-manch",
  "private": true,
  "type": "module",
  "version": "1.0.2",
  "description": "Gyan Manch bilingual competitive-exam practice website",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && mkdir -p dist && cp index.html _headers manifest.webmanifest cbt-modern.css dist/ && node --input-type=module -e 'import fs from "node:fs";const p="dist/index.html";let s=fs.readFileSync(p,"utf8");s=s.replace("</head>","<link rel=\\\"stylesheet\\\" href=\\\"/cbt-modern.css\\\">\\n</head>");s=s.replace("<span class=\\\"text-slate-700 font-semibold\\\">Unans</span>","<span class=\\\"text-slate-700 font-semibold\\\">Not Answered</span>");s=s.replace("<span class=\\\"text-slate-700 font-semibold\\\">Review</span>","<span class=\\\"text-slate-700 font-semibold\\\">Marked for Review</span>");s=s.replace("<span class=\\\"text-slate-700 font-semibold\\\">Ans+Rev</span>","<span class=\\\"text-slate-700 font-semibold\\\">Ans. + Review</span>");s=s.replace("★ Mark for Review &amp; Next","Mark for Review &amp; Next");fs.writeFileSync(p,s)'"
  }
}
